      "id": "example.widgets.what-is-a-widget",
      "type": "basic",
      "kind": "primer",
      "priority": "core",
      "order": 10,
      "front": "What is a widget, in one sentence?",
      "back": "A small part that turns a handle into motion.",
      "explanation": "Everything else in this deck builds on widgets, so it comes first.",
      "example": "Like a door handle, but it moves a gear instead of a latch.",
      "source": "Example Handbook, §1",
      "sourceURL": "https://example.org/handbook#1",
      "sourceLicence": "B · CC BY 4.0",
      "introduces": [
        "widget"
